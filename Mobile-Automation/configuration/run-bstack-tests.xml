<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Mobile Authorization Test Suite">
    <listeners>
        <listener class-name="helpers.MyListener"></listener>
    </listeners>
    <test name="Mobile-Automation tests">
        <parameter name="config" value="bstack"></parameter>
        <classes>
            <class name="tests.AuthorizationTests">
                <methods>
                    <include name="logInWithValidCredentialsTest"></include>
                </methods>
            </class>
        </classes>
    </test>
</suite>
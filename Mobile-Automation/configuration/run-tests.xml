<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Mobile All Test Suite">
    <listeners>
        <listener class-name="helpers.MyListener"></listener>
    </listeners>
    <test name="Mobile-Automation tests">
        <parameter name="config" value="local"></parameter>
        <parameter name="systemPort" value="4723"></parameter>
        <packages>
            <package name="tests.*"></package>
        </packages>
    </test>
</suite>